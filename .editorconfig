root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[{*.go,go.mod,Makefile}]
indent_style = tab
indent_size = 4

# The patched upstream copy and the fixtures stay byte for byte as they are.
[{third_party/**,testdata/**,examples/**}]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
