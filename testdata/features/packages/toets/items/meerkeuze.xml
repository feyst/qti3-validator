<?xml version="1.0" encoding="UTF-8"?>
<qti-assessment-item xmlns="http://www.imsglobal.org/xsd/imsqtiasi_v3p0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.imsglobal.org/xsd/imsqtiasi_v3p0 https://purl.imsglobal.org/spec/qti/v3p0/schema/xsd/imsqti_asiv3p0_v1p0.xsd"
    identifier="meerkeuze" title="Provincies aan zee" adaptive="false" time-dependent="false" xml:lang="nl">
  <qti-response-declaration identifier="RESPONSE" cardinality="multiple" base-type="identifier">
    <qti-correct-response>
      <qti-value>ZH</qti-value>
      <qti-value>NH</qti-value>
      <qti-value>ZE</qti-value>
    </qti-correct-response>
    <qti-mapping lower-bound="0" upper-bound="3" default-value="0">
      <qti-map-entry map-key="ZH" mapped-value="1"/>
      <qti-map-entry map-key="NH" mapped-value="1"/>
      <qti-map-entry map-key="ZE" mapped-value="1"/>
      <qti-map-entry map-key="UT" mapped-value="-1"/>
    </qti-mapping>
  </qti-response-declaration>
  <qti-outcome-declaration identifier="SCORE" cardinality="single" base-type="float">
    <qti-default-value>
      <qti-value>0</qti-value>
    </qti-default-value>
  </qti-outcome-declaration>
  <qti-item-body>
    <qti-choice-interaction response-identifier="RESPONSE" shuffle="false" max-choices="0">
      <qti-prompt>Welke provincies grenzen aan de Noordzee?</qti-prompt>
      <qti-simple-choice identifier="ZH">Zuid-Holland</qti-simple-choice>
      <qti-simple-choice identifier="UT">Utrecht</qti-simple-choice>
      <qti-simple-choice identifier="NH">Noord-Holland</qti-simple-choice>
      <qti-simple-choice identifier="ZE">Zeeland</qti-simple-choice>
    </qti-choice-interaction>
  </qti-item-body>
  <qti-response-processing template="https://purl.imsglobal.org/spec/qti/v3p0/rptemplates/map_response.xml"/>
</qti-assessment-item>
