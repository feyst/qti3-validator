<?xml version="1.0" encoding="UTF-8"?>
<qti-assessment-item xmlns="http://www.imsglobal.org/xsd/imsqtiasi_v3p0" identifier="set-target-declared" title="set-target-declared" adaptive="false" time-dependent="false">
  <qti-response-declaration identifier="RESPONSE" cardinality="single" base-type="identifier"><qti-correct-response><qti-value>A</qti-value></qti-correct-response></qti-response-declaration>
  <qti-outcome-declaration identifier="SCORE" cardinality="single" base-type="float"/>
  <qti-template-declaration identifier="T" cardinality="single" base-type="integer"/>
  <qti-template-processing>
    <qti-set-template-value identifier="T"><qti-base-value base-type="integer">1</qti-base-value></qti-set-template-value>
    <qti-set-template-value identifier="NO_TEMPLATE"><qti-base-value base-type="integer">1</qti-base-value></qti-set-template-value>
    <qti-set-correct-response identifier="NO_RESPONSE"><qti-base-value base-type="identifier">A</qti-base-value></qti-set-correct-response>
    <qti-set-default-value identifier="SCORE"><qti-base-value base-type="float">0</qti-base-value></qti-set-default-value>
    <qti-set-default-value identifier="NO_VARIABLE"><qti-base-value base-type="float">0</qti-base-value></qti-set-default-value>
  </qti-template-processing>
  <qti-item-body><qti-choice-interaction response-identifier="RESPONSE" max-choices="1">
      <qti-simple-choice identifier="A">A</qti-simple-choice>
      <qti-simple-choice identifier="B">B</qti-simple-choice>
    </qti-choice-interaction></qti-item-body>
  <qti-response-processing>
    <qti-set-outcome-value identifier="SCORE"><qti-base-value base-type="float">1</qti-base-value></qti-set-outcome-value>
    <qti-set-outcome-value identifier="completionStatus"><qti-base-value base-type="identifier">completed</qti-base-value></qti-set-outcome-value>
    <qti-set-outcome-value identifier="NO_OUTCOME"><qti-base-value base-type="float">1</qti-base-value></qti-set-outcome-value>
  </qti-response-processing>
</qti-assessment-item>
